{%- comment -%}
  Material / Care accordion. Content is keyed to the product's category via
  product.type (which also drives the type-based collections: T-shirts,
  Hoodies & Sweatshirts, Socks, Backpacks & Bags). Matching is normalized
  (downcased + synonyms) so it is resilient to type casing/pluralization.

  Accepts: product_type
{%- endcomment -%}

{%- assign type = product_type | downcase | strip -%}

<div class="product__accordion accordion">
  <details>
    <summary>
      <div class="summary__title">
        {% render 'icon-accordion', icon: 'leather' %}
        <h2 class="h4 accordion__title inline-richtext">Material / care</h2>
      </div>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte">
      {%- case type -%}
        {%- when 't-shirt', 't-shirts', 'tee', 'tees', 't shirt' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>Solids: 100% ring-spun cotton</li>
            <li>Heathers: 50% cotton, 50% polyester</li>
            <li>Twill tape at shoulders, ribbed knit collar</li>
            <li>Sewn-in or tear-away labels for comfort</li>
            <li>No side seams (tubular knit)</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash warm (max 40°C), inside out</li>
            <li>Tumble dry medium heat</li>
            <li>Iron inside out on low heat</li>
            <li>Non-chlorine bleach only as needed</li>
            <li>Do not dry clean</li>
          </ul>
          <p><strong>Certifications:</strong> US Cotton Trust Protocol, OEKO-TEX Standard 100, REACH</p>

        {%- when 'hoodie', 'hoodies', 'sweatshirt', 'sweatshirts' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>Ring-spun cotton / polyester blend</li>
            <li>Brushed fleece interior</li>
            <li>Double-lined hood, metal eyelets (hoodies)</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold, inside out</li>
            <li>Tumble dry low</li>
            <li>Iron inside out on low heat</li>
            <li>Do not bleach or dry clean</li>
          </ul>
          <p><strong>Certifications:</strong> OEKO-TEX Standard 100, REACH</p>

        {%- when 'socks', 'sock' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>Polyester / cotton / spandex blend</li>
            <li>Cushioned sole, reinforced heel and toe</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold</li>
            <li>Tumble dry low</li>
            <li>Do not bleach or iron</li>
          </ul>

        {%- when 'bag', 'bags', 'backpack', 'backpacks', 'tote', 'tote bag' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>Durable water-resistant polyester shell</li>
            <li>Reinforced stitching and straps</li>
            <li>Lined interior with secure closure</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Wipe clean with a damp cloth</li>
            <li>Air dry fully before storing</li>
            <li>Do not machine wash, tumble dry, or iron</li>
          </ul>

        {%- else -%}
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold, inside out</li>
            <li>Tumble dry low</li>
            <li>Iron inside out on low heat</li>
            <li>Do not bleach</li>
          </ul>
      {%- endcase -%}
    </div>
  </details>
</div>
