<div class="product__accordion accordion">
  <details>
    <summary>
      <div class="summary__title">
        {% render 'icon-accordion', icon: 'leather' %}
        <h2 class="h4 accordion__title inline-richtext">Material / care</h2>
      </div>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte">
      {%- case product_type -%}
        {%- when 'T-Shirt', 'T-Shirts', "Kids' T-Shirts", 'Kids clothes' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>Solids: 100% US cotton (5.3 oz/yd²)</li>
            <li>Heathers: 50% cotton, 50% polyester</li>
            <li>Twill tape at shoulders, ribbed knit collar</li>
            <li>Tear-away labels for comfort</li>
            <li>No side seams (tubular knit)</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash warm (max 40°C)</li>
            <li>Tumble dry medium heat</li>
            <li>Iron low heat — do not iron directly on print</li>
            <li>Non-chlorine bleach as needed</li>
            <li>Do not dry clean</li>
          </ul>
          <p><strong>Certifications:</strong> US Cotton Trust Protocol, OEKO-TEX Standard 100, REACH</p>

        {%- when 'Hoodie', 'Hoodies', 'Sweatshirt', 'Sweatshirts' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>80% ring-spun cotton, 20% polyester</li>
            <li>Brushed fleece interior</li>
            <li>Double-lined hood, metal eyelets</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold, inside out</li>
            <li>Tumble dry low</li>
            <li>Do not iron directly on print</li>
            <li>Do not bleach or dry clean</li>
          </ul>

        {%- when 'Socks' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>60% nylon, 22% cotton, 18% spandex</li>
            <li>Cushioned sole, reinforced heel and toe</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold</li>
            <li>Tumble dry low</li>
            <li>Do not bleach</li>
          </ul>

        {%- when 'Hat', 'Hats', 'Cap', 'Caps' -%}
          <p><strong>Material</strong></p>
          <ul>
            <li>100% polyester foam front</li>
            <li>Mesh back panels</li>
            <li>Adjustable snap closure</li>
          </ul>
          <p><strong>Care</strong></p>
          <ul>
            <li>Spot clean only</li>
            <li>Do not machine wash</li>
            <li>Air dry</li>
          </ul>

        {%- else -%}
          <p><strong>Care</strong></p>
          <ul>
            <li>Machine wash cold, inside out</li>
            <li>Tumble dry low</li>
            <li>Do not iron directly on print</li>
            <li>Do not bleach</li>
          </ul>
      {%- endcase -%}
    </div>
  </details>
</div>
